+  bool isLocalMidnight(std::chrono::system_clock::time_point time) {
+    const std::time_t raw = std::chrono::system_clock::to_time_t(time);
+    std::tm value{};
+    localtime_r(&raw, &value);
+    return value.tm_hour == 0 && value.tm_min == 0 && value.tm_sec == 0;
+  }
