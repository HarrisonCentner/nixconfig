+void ScreenTimeService::setSessionLocked(bool locked) {
+  if (m_sessionLocked == locked) {
+    return;
+  }
+  m_sessionLocked = locked;
+  if (locked) {
+    flushActiveSession(std::chrono::steady_clock::now());
+    m_activeAppKey.clear();
+    m_activeSince = {};
+    if (m_dirty) {
+      save();
+    }
+  } else if (m_enabled) {
+    onFocusChange();
+  }
+}
+
