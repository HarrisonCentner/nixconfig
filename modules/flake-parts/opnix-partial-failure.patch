+// errors.Join would hide the exit code: ExitCode only walks single-error
+// Unwrap chains, so merge failure lists into one ProviderResolutionError.
+func mergeResolveErrors(fieldErr, fileErr error) error {
+	if fieldErr == nil {
+		return fileErr
+	}
+	if fileErr == nil {
+		return fieldErr
+	}
+	var fieldRes, fileRes *errors.ProviderResolutionError
+	if stderrors.As(fieldErr, &fieldRes) && stderrors.As(fileErr, &fileRes) {
+		failures := append([]*errors.ProviderError{}, fieldRes.Failures...)
+		return &errors.ProviderResolutionError{Failures: append(failures, fileRes.Failures...)}
+	}
+	return fieldErr
+}
