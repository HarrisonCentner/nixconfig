{
  "suggest.autoTrigger": "always",
  "diagnostic.virtualText": true,
  "languageserver": {
    "dhall": {
      "command": "dhall-lsp-server",
      "filetypes": [
        "dhall"
      ]
    },
    "nix": {
      "command": "nixd",
      "filetypes": ["nix"]
    },
    "clojure": {
      "command": "clojure-lsp",
      "host": "127.0.0.1",
      "port": 7891,
      "filetypes": ["clojure", "edn"]
      "rootPatterns": ["project.clj", "deps.edn"],
      "additionalSchemes": ["jar", "zipfile"],
      "trace.server": "verbose",
      "progressOnInitialization": true,
      "diagnostic.showUnused": true,
      "diagnostic.showDeprecated": true,
      "diagnostic.highlightPriority": 1000000,
      "lsp-check-on-start": false,
      "startup-message": true,
      "semanticTokens.enable": true
      "initializationOptions": {
        "semantic-tokens?": true,
        "use-metadata-for-privacy?": true,
        "ignore-classpath-directories": true
      }
    },
  },
  "diagnostic-languageserver.linters": {
    "clj_kondo_lint": {
      "command": "clj-kondo",
      "debounce": 100,
      "args": [ "--lint", "%filepath"],
      "offsetLine": 0,
      "offsetColumn": 0,
      "sourceName": "clj-kondo",
      "formatLines": 1,
      "formatPattern": [
        "^[^:]+:(\\d+):(\\d+):\\s+([^:]+):\\s+(.*)$",
        {
          "line": 1,
          "column": 2,
          "message": 4,
          "security": 3
        }
      ],
      "securities": {
        "error": "error",
        "warning": "warning",
        "note": "info"
      }
    }
  },
  "diagnostic-languageserver.filetypes": {"clojure":"clj_kondo_lint"}
}
